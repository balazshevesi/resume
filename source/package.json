{
  "name": "pdf-resume",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun vite",
    "build": "bun run get-fonts && bun run tsc -b && bun run vite build",
    "get-fonts": "bun scripts/get-fonts.ts",
    "generate-pdf": "bun scripts/generatePdf.tsx",
    "lint": "bun eslint .",
    "postinstall": "bun patch-package",
    "preview": "bun vite preview",
    "test": "bun vitest run",
    "test:watch": "bun vitest"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {
    "@react-pdf/render": "4.5.1",
    "@react-pdf/pdfkit": "5.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "patch-package": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
